<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mechanicworkshop.addControllers.VehiculoAddController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <fx:include fx:id="header" source="../components/section-header.fxml" />

    <GridPane vgap="15" hgap="10" alignment="TOP_CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="120" halignment="RIGHT" />
            <ColumnConstraints minWidth="300" hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Marca:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="marcaField" promptText="Ej: Toyota" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Modelo:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="modeloField" promptText="Ej: Corolla" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Matrícula:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="matriculaField" promptText="0000-XXX" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Año:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="anioField" promptText="Ej: 2020" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Propietario:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="clienteCombo" promptText="Seleccione un cliente" prefWidth="300" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Label fx:id="mensajeLabel" textFill="red" visible="false"/>
        <Button text="Guardar Vehículo" onAction="#guardarVehiculo" defaultButton="true"/>
    </HBox>
</VBox>