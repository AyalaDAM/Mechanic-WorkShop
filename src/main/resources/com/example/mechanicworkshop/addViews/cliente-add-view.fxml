<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mechanicworkshop.addControllers.ClienteAddController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <fx:include fx:id="header" source="../components/section-header.fxml" />

    <GridPane vgap="15" hgap="10" alignment="TOP_CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="100" halignment="RIGHT" />
            <ColumnConstraints minWidth="300" hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nombreField" promptText="Ingrese el nombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Apellidos:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="apellidoField" promptText="Ingrese los apellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="telefonoField" promptText="600000000" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="cliente@ejemplo.com" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Label fx:id="mensajeLabel" textFill="red" visible="false"/>
        <Button text="Guardar Cliente" onAction="#guardarCliente" defaultButton="true"/>
    </HBox>
</VBox>