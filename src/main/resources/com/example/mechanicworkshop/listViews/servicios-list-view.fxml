<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.mechanicworkshop.listControllers.ServiciosListController"
      prefHeight="400.0" prefWidth="600.0">

    <TableView fx:id="serviciosTable">
        <columns>
            <TableColumn fx:id="colServicioId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colServicioDescripcion" text="Descripción" prefWidth="200"/>
            <TableColumn fx:id="colServicioPrecio" text="Precio" prefWidth="100"/>
            <TableColumn fx:id="colServicioDuracion" text="Duración (h)" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
