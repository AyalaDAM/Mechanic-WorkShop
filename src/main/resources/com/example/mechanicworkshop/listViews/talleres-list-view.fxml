<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.mechanicworkshop.listControllers.TalleresListController"
      prefHeight="400.0" prefWidth="600.0">

    <TableView fx:id="talleresTable">
        <columns>
            <TableColumn fx:id="colTallerId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTallerNombre" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colTallerDireccion" text="Dirección" prefWidth="200"/>
            <TableColumn fx:id="colTallerTelefono" text="Teléfono" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
