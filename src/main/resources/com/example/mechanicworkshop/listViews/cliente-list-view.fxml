<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.mechanicworkshop.listControllers.ClienteListController"
      prefHeight="400.0" prefWidth="600.0">

    <TableView fx:id="clientesTable">
        <columns>
            <TableColumn fx:id="colClienteId" text="ID" prefWidth="50" />
            <TableColumn fx:id="colClienteNombre" text="Nombre" prefWidth="150" />
            <TableColumn fx:id="colClienteApellido" text="Apellido" prefWidth="150" />
            <TableColumn fx:id="colClienteTelefono" text="Teléfono" prefWidth="120" />
            <TableColumn fx:id="colClienteEmail" text="Email" prefWidth="200" />
        </columns>
    </TableView>

</VBox>
