<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="20.0" styleClass="login-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mechanicworkshop.LoginController">
    <stylesheets>
        <URL value="@css/style.css" />
    </stylesheets>

    <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <Text text="Taller" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
        <Text text="Gestión de Taller" style="-fx-fill: #7f8c8d;"/>

        <Region prefHeight="20"/>

        <TextField fx:id="userField" promptText="Usuario" prefWidth="250" style="-fx-padding: 10;"/>
        <PasswordField fx:id="passField" promptText="Contraseña" prefWidth="250" style="-fx-padding: 10;"/>

        <Region prefHeight="10"/>

        <Button text="Iniciar Sesión" onAction="#handleLogin" prefWidth="250" style="-fx-padding: 10;"/>
    </VBox>
</VBox>