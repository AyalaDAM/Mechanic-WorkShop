<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mechanicworkshop.ListadosController">

    <top>
        <Label text="Listado de la Base de Datos" style="-fx-font-size: 20px; -fx-padding: 10px;" />
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" prefWidth="900" prefHeight="600">

            <Tab text="Clientes">
                <TableView fx:id="clientesTable">
                    <columns>
                        <TableColumn fx:id="colClienteId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colClienteNombre" text="Nombre" prefWidth="150" />
                        <TableColumn fx:id="colClienteApellido" text="Apellido" prefWidth="150" />
                        <TableColumn fx:id="colClienteTelefono" text="Teléfono" prefWidth="120" />
                        <TableColumn fx:id="colClienteEmail" text="Email" prefWidth="200" />
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Vehículos">
                <TableView fx:id="vehiculosTable">
                    <columns>
                        <TableColumn fx:id="colVehiculoId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colVehiculoCliente" text="Cliente" prefWidth="150"/>
                        <TableColumn fx:id="colVehiculoMarca" text="Marca" prefWidth="100"/>
                        <TableColumn fx:id="colVehiculoModelo" text="Modelo" prefWidth="100"/>
                        <TableColumn fx:id="colVehiculoMatricula" text="Matrícula" prefWidth="100"/>
                        <TableColumn fx:id="colVehiculoAnio" text="Año" prefWidth="70"/>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Talleres">
                <TableView fx:id="talleresTable">
                    <columns>
                        <TableColumn fx:id="colTallerId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colTallerNombre" text="Nombre" prefWidth="200"/>
                        <TableColumn fx:id="colTallerDireccion" text="Dirección" prefWidth="200"/>
                        <TableColumn fx:id="colTallerTelefono" text="Teléfono" prefWidth="120"/>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Trabajadores">
                <TableView fx:id="trabajadoresTable">
                    <columns>
                        <TableColumn fx:id="colTrabajadorId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colTrabajadorNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colTrabajadorApellido" text="Apellido" prefWidth="150"/>
                        <TableColumn fx:id="colTrabajadorPuesto" text="Puesto" prefWidth="120"/>
                        <TableColumn fx:id="colTrabajadorTelefono" text="Teléfono" prefWidth="120"/>
                        <TableColumn fx:id="colTrabajadorTaller" text="Taller" prefWidth="150"/>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Servicios">
                <TableView fx:id="serviciosTable">
                    <columns>
                        <TableColumn fx:id="colServicioId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colServicioDescripcion" text="Descripción" prefWidth="200"/>
                        <TableColumn fx:id="colServicioPrecio" text="Precio" prefWidth="100"/>
                        <TableColumn fx:id="colServicioDuracion" text="Duración (h)" prefWidth="100"/>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Piezas">
                <TableView fx:id="piezasTable">
                    <columns>
                        <TableColumn fx:id="colPiezaId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colPiezaNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colPiezaDescripcion" text="Descripción" prefWidth="200"/>
                        <TableColumn fx:id="colPiezaPrecio" text="Precio" prefWidth="100"/>
                        <TableColumn fx:id="colPiezaStock" text="Stock" prefWidth="80"/>
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Citas">
                <TableView fx:id="citasTable">
                    <columns>
                        <TableColumn fx:id="colCitaId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colCitaCliente" text="Cliente" prefWidth="150"/>
                        <TableColumn fx:id="colCitaVehiculo" text="Vehículo" prefWidth="150"/>
                        <TableColumn fx:id="colCitaTrabajador" text="Trabajador" prefWidth="150"/>
                        <TableColumn fx:id="colCitaServicio" text="Servicio" prefWidth="150"/>
                        <TableColumn fx:id="colCitaFechaHora" text="Fecha/Hora" prefWidth="150"/>
                        <TableColumn fx:id="colCitaEstado" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="colCitaValoracion" text="Valoración" prefWidth="80"/>
                    </columns>
                </TableView>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
